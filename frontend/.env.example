# Frontend Environment Variables
# In production, point to your Render backend web service URL:
# VITE_API_URL=https://evalgen-backend.onrender.com/api/v1
# In local development, the Vite proxy handles /api -> http://localhost:8000
VITE_API_URL=/api/v1
# Active Gemini Model (must match GEMINI_MODEL in backend/.env)
VITE_GEMINI_MODEL=gemini-3.8-flash
