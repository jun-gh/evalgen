# Application Configuration
APP_NAME=EvalGen
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Local Development default (SQLite async):
DATABASE_URL=sqlite+aiosqlite:///./.data/evalgen.db
# Production (Neon Serverless Postgres):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require

# AI / Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Security / CORS
CORS_ORIGINS=["http://localhost:5173","https://evalgen.pages.dev"]

# Model Context Protocol (MCP) Optional Servers
MCP_SERVERS_CONFIG_PATH=
